# Copy this file to secrets.yaml on the Frigate host (/config/secrets.yaml)
# and fill in the REAL values. Never commit the real secrets.yaml.
#
# URL-encode special characters in passwords that appear inside RTSP URLs:
#   @  ->  %40        #  ->  %23        :  ->  %3A        /  ->  %2F
# ffmpeg decodes these back before authenticating, so the camera still sees
# the original password. (e.g. a password "Secret@1#" is stored as "Secret@1%23")

mqtt_password: CHANGE_ME

cam_driveway_pw: CHANGE_ME          # 192.168.1.233  (user: admin)
cam_doorbell_pw: CHANGE_ME          # 192.168.1.205  (user: admin)
cam_backyard_pw: CHANGE_ME          # 192.168.1.183  (user: admin)  - encode the trailing #
cam_dining_pw: CHANGE_ME            # 192.168.1.249  (user: admin2)
