# Frigate reads secrets from ENVIRONMENT VARIABLES, not a secrets file.
# Any {FRIGATE_*} placeholder in config.yml is replaced with the matching
# variable below. Provide these to the container, e.g.:
#
#   docker compose:   env_file: ./frigate.env       (or an `environment:` block)
#   docker run:       --env-file ./frigate.env
#
# Copy this to frigate.env, fill in REAL values, and keep it out of git.
#
# URL-encode special characters in the CAMERA password values (they are placed
# inside RTSP URLs): @ -> %40 , # -> %23 , : -> %3A , / -> %2F
# ffmpeg decodes them back before authenticating.
# The MQTT password is NOT in a URL, so use it raw (no encoding).

FRIGATE_MQTT_PASSWORD=CHANGE_ME

FRIGATE_CAM_DRIVEWAY_PW=CHANGE_ME      # 192.168.1.233  user: admin
FRIGATE_CAM_DOORBELL_PW=CHANGE_ME      # 192.168.1.205  user: admin
FRIGATE_CAM_BACKYARD_PW=CHANGE_ME      # 192.168.1.183  user: admin   (URL-encode the trailing #)
FRIGATE_CAM_DINING_PW=CHANGE_ME        # 192.168.1.249  user: admin2
